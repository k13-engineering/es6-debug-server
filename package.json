{
    "type": "module",
    "main": "lib/index.ts",
    "dependencies": {
        "@typescript-eslint/typescript-estree": "^8.70.1",
        "debug": "^4.3.4",
        "pathe": "^2.0.3"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@k13engineering/eslint-rules": "^0.0.6",
        "@k13engineering/releasetool": "^0.0.5",
        "@types/debug": "^4.1.12",
        "@types/estree": "^1.0.5",
        "@types/mocha": "^10.0.10",
        "@types/node": "^26.6.3",
        "c8": "^12.0.0",
        "deno-node": "^0.0.12",
        "mocha": "^12.0.2",
        "npm-check-updates": "^23.1.0",
        "typescript": "^6.0.3"
    },
    "scripts": {
        "build": "rm -rf dist/ && deno-node-build --root . --out dist/ --entry lib/index.ts",
        "type-check": "tsc --noEmit",
        "lint": "eslint .",
        "test": "c8 --reporter lcov --reporter html --reporter text --all --src lib/ --exclude lib/snippets/ --exclude test/ --exclude 'lib/**/*.spec.ts' mocha test/**/*.ts lib/**/*.spec.ts",
        "update-deps": "npm-check-updates -u"
    }
}
